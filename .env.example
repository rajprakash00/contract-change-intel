# Copy to .env for local overrides; real deployments pass these as environment variables.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/cci

# Where uploaded files are stored ({DATA_DIR}/{tenant_id}/{sha256}).
# DATA_DIR=./data
# MAX_UPLOAD_MB=50

# W5·C auth: OIDC bearer JWTs via Auth0. There is no "auth off" mode — the
# API rejects everything (503) until both are set.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
# AUTH_JWKS_CACHE_SECONDS=600

# ADR-010: per-tenant hourly budgets on the LLM-enqueue endpoints
# (0 blocks all calls for that kind; docs/decisions/ADR-010 for the
# multi-replica scaling path).
# RATE_LIMIT_EXTRACTION_PER_HOUR=60
# RATE_LIMIT_CHANGE_REPORT_PER_HOUR=60
